# --- Core ---
PORT=3001
MONGO_URI=mongodb://localhost:27017/packetflow
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- CORS allowlist (comma-separated browser origins) ---
# Defaults to common local dev ports if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Admin bootstrap (used by `npm run create-admin`) ---
ADMIN_EMAIL=admin@packetflow.io
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=PacketFlow Admin
