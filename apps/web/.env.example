# PacketFlow web-app environment
# Copy to `.env.local` for local dev overrides (Vite auto-loads it).

# Base URL of the backend API (see backend/src/app.ts — routes mount under /api/v1).
# Defaults to this value when unset, so local dev works without any .env file.
VITE_API_URL=http://localhost:3001/api/v1
